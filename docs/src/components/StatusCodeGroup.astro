---
import type { statusCodes } from "../data/status-codes";
import type { Locale } from "../i18n/messages";
import { statusMessages } from "../i18n/status";

interface Props {
  locale: Locale;
  id: string;
  title: string;
  statuses: (typeof statusCodes)[number][];
}
const { id, title, statuses, locale } = Astro.props;
const t = statusMessages[locale];
---

<section class="status-group" data-status-group={id} aria-labelledby={`status-${id}`}>
  <h2 id={`status-${id}`}><code>{id}</code> {title}</h2>
  <div class="status-accordions">
    {statuses.map((status) => (
      <details class="collapse collapse-arrow bg-base-100 border border-solid border-base-300" name="status-code-accordion">
        <summary class="collapse-title font-semibold">
          <code class="badge badge-sm method">{status.code}</code>
          <span lang="en">{status.title}</span>
        </summary>
        <div class="collapse-content text-sm">
          <div class="status-description" lang={locale} set:html={status.descriptionHtml} />
          <p class="status-attribution">
            <strong>{t.source}:</strong>{" "}<a href={status.source}>{status.source}</a>
          </p>
        </div>
      </details>
    ))}
  </div>
</section>
