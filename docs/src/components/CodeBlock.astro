---
import { localeFromPath } from '../i18n/locales'
import { type CodeLanguage, highlight } from '../lib/highlight'
import CopyButton from './CopyButton.astro'

interface Props {
  text: string
  lang?: CodeLanguage
  'data-curl-example'?: number
  'data-response-body'?: boolean
}

const { text, lang = 'text', ...attributes } = Astro.props
const tokens = highlight(text, lang)
---

<div class="code-block" data-code-block>
  <pre><code {...attributes}>{tokens.map((line, index) => <Fragment>{index > 0 ? '\n' : ''}{line.map(token => <span style={token.htmlStyle}>{token.content}</span>)}</Fragment>)}</code></pre>
  <CopyButton locale={localeFromPath(Astro.url.pathname)} />
</div>

<style>
  .code-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    min-width: 0;
  }
  .code-block > pre {
    margin: 0;
    padding: 0.5rem;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    min-width: 0;
    white-space: pre;
  }
  .code-block code { overflow-wrap: normal; }
  @media (prefers-color-scheme: dark) {
    .code-block :global(code span) { color: var(--shiki-dark) !important; }
  }
</style>
