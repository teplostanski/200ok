---
import plexMono from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import plexMonoSemibold from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";
import soraLatin from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import "../styles/site.css";

import {
  defaultLocale,
  localeCodes,
  locales,
  localizedPath,
} from "../i18n/locales";
import { type Locale, messages } from "../i18n/messages";
import { languageUrl } from "../i18n/paths";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const {
  title,
  locale,
  description = messages[Astro.props.locale].metaDescription,
} = Astro.props;
const t = messages[locale];
const pageTitle = `${title} - 200 OK`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.png", Astro.site);
const ogImageAlt = "200 OK: HTTP Request & Response Service";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="200 OK" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="color-scheme" content="light dark" />
    <style is:inline>
      html {
        color-scheme: light;
        background-color: #f3f5f7;
        color: #152028;
      }
      @media (prefers-color-scheme: dark) {
        html {
          color-scheme: dark;
          background-color: #0d1216;
          color: #e7eef2;
        }
      }
    </style>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1216" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMonoSemibold} as="font" type="font/woff2" crossorigin />
    {localeCodes.map((code) => <link rel="alternate" hreflang={code} href={languageUrl(Astro.url, code)} />)}
    <link rel="alternate" hreflang="x-default" href={languageUrl(Astro.url, defaultLocale)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="brand" href={localizedPath("/", locale)}>200 OK</a>
      <div class="header-tools">
        <span>API v1</span>
        <select class="select select-sm language-switch" aria-label={t.language} data-language-select>
          {localeCodes.map((code) => (
            <option value={code} lang={code} selected={locale === code}>{locales[code]}</option>
          ))}
        </select>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <span>© 2026-present Teplostanski Igor</span>
      <a href="https://github.com/teplostanski/200ok">GitHub</a>
      <p class="footer-signoff">Happy hacking!</p>
    </footer>
  </body>
</html>

<script>
  import { isLocale, localeFromPath } from "../i18n/locales";
  import { languageUrl } from "../i18n/paths";

  const select = document.querySelector<HTMLSelectElement>("[data-language-select]");
  if (select) {
    const syncLocale = () => {
      select.value = localeFromPath(window.location.pathname);
    };
    syncLocale();
    window.addEventListener("pageshow", syncLocale);
    select.addEventListener("change", () => {
      if (!isLocale(select.value)) return;
      const url = new URL(window.location.href);
      const target = languageUrl(url, select.value);
      if (target !== `${url.pathname}${url.search}${url.hash}`) {
        window.location.assign(target);
      }
    });
  }
</script>
