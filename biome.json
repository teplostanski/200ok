{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@teplostanski/biome-config/configs/base"],
  "files": {
    "includes": ["**", "!!dist", "!!node_modules", "!!docs/.astro"]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
