# Optional overrides for .env.development / .env.production.
# Process environment variables take priority over all env files.
# HOST=127.0.0.1
# PORT=3100
# DOCS_HOST=127.0.0.1
# DOCS_PORT=4322
# BIND_HOST=127.0.0.1
# PUBLISHED_PORT=3100
# Empty disables proxy trust; otherwise specify trusted IP addresses/subnets.
# TRUST_PROXY=
# BASE_URL=https://api.example.com
# BODY_LIMIT_BYTES=1048576
# JSON_MAX_DEPTH=256
