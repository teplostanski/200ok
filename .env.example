# Optional: pin the port (disables automatic selection in development).
# PORT=3000
HOST=0.0.0.0
# Optional: trusted proxy IP addresses/subnets, comma-separated.
# TRUST_PROXY=loopback
# Optional: maximum object/array nesting in JSON bodies (1-512, default 64).
# JSON_MAX_DEPTH=64
# Required for documentation/Docker builds; optional for API and development.
# Set the deployment origin here; Docker Compose passes it into the image.
# BASE_URL=https://api.example.com
# Optional: maximum request body size after decompression, in bytes (positive integer).
# BODY_LIMIT_BYTES=102400
